# Copy this file to .env and fill in the values
PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
# MySQL port: 3306 (Windows installer, XAMPP, Homebrew) or 8889 (MAMP on Mac)
DB_PORT=3306
DB_NAME=mobilefrei
DB_USER=root
# The MySQL root password chosen when installing MySQL
DB_PASSWORD=

# Use a long random string (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change_me

# Password of the admin account created by the seeder (admin@efrei.net)
ADMIN_PASSWORD=Admin1234

# Second admin account (created by the seeder 20261124000001-second-admin.js)
ADMIN2_EMAIL=lahouari.guetarni@efrei.net
ADMIN2_USERNAME=laboiserie
ADMIN2_PASSWORD=

# Optional: send the codes by real email (e.g. Gmail + an app password).
# Leave empty to print the codes in the back-end terminal (enough for the demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
